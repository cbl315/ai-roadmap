# ==============================================
# AI Agent 学习项目 — 环境变量配置
# ==============================================
# 复制此文件为 .env 并填入你的 API Key:
#   cp .env.example .env
#
# ⚠️ 永远不要将 .env 提交到 Git！

# --- LLM Provider API Keys ---

# Anthropic (Claude)
# 获取地址: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI (GPT)
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# --- 自定义 API 端点（可选）---
# 用于代理 / 中转 / OpenAI 兼容服务（如 one-api、vLLM、公司网关）
# 不配置或留空 = 使用官方地址
# ANTHROPIC_BASE_URL=https://your-proxy.example.com
# OPENAI_BASE_URL=https://your-relay.example.com/v1

# --- 默认模型配置 ---

# Claude 默认模型 (推荐: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI 默认模型 (gpt-4o / GPT-5 系列均可，脚本已适配 max_completion_tokens)
OPENAI_MODEL=gpt-4o

# OpenAI Embedding 模型 (用于 RAG 模块)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- 可选配置 ---

# 默认 LLM Provider (claude | openai)
DEFAULT_PROVIDER=claude

# 日志级别 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
